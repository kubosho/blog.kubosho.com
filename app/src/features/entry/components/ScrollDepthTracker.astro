---
export interface Props {
  entryId: string;
  entryTitle: string;
}

const { entryId, entryTitle } = Astro.props;
---

<div id="scroll-depth-tracker" data-entry-id={entryId} data-entry-title={entryTitle}></div>

<script>
  import { pushEvent } from '../../../data/tracking/dataLayer';

  const tracker = document.getElementById('scroll-depth-tracker');
  const contents = tracker?.parentElement;
  if (tracker != null && contents != null) {
    const entryId = tracker.dataset.entryId ?? '';
    const entryTitle = tracker.dataset.entryTitle ?? '';
    const thresholds = [25, 50, 75, 90];
    const fired = new Set<number>();

    // IntersectionObserver reports intersection once per rendering frame. A zero-height
    // marker at a threshold is never seen when one scroll jump moves the viewport past it.
    const trackScrollDepth = () => {
      const rect = contents.getBoundingClientRect();
      const scrollDepth = ((window.innerHeight - rect.top) / rect.height) * 100;

      for (const pct of thresholds) {
        if (scrollDepth < pct || fired.has(pct)) {
          continue;
        }
        fired.add(pct);
        pushEvent({
          event: 'scroll_depth',
          scroll_percentage: pct,
          entry_id: entryId,
          entry_title: entryTitle,
        });
      }

      if (fired.size === thresholds.length) {
        window.removeEventListener('scroll', trackScrollDepth);
      }
    };

    // Content already visible on the first paint does not count as read, so the
    // depth is never measured before the reader scrolls.
    window.addEventListener('scroll', trackScrollDepth, { passive: true });
  }
</script>
