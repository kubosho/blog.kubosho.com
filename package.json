{
  "name": "@kubosho/blog",
  "version": "11.19.11",
  "license": "MIT",
  "private": true,
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "app"
  ],
  "scripts": {
    "preview": "npm run --workspace=app preview --",
    "build": "npm run --workspace=app build --",
    "build:stg": "npm run --workspace=app build:stg --",
    "build:prd": "npm run --workspace=app build:prd --",
    "dev": "npm run --workspace=app dev --",
    "dev:prd": "npm run --workspace=app dev:prd --",
    "deploy": "npm run --workspace=app deploy --",
    "deploy:prd": "npm run --workspace=app deploy:prd --",
