{
  "name": "@kubosho/blog",
  "version": "11.19.13",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "preview": "pnpm --filter ./app run preview",
    "build": "pnpm --filter ./app run build",
    "build:stg": "pnpm --filter ./app run build:stg",
    "build:prd": "pnpm --filter ./app run build:prd",
    "dev": "pnpm --filter ./app run dev",
    "dev:prd": "pnpm --filter ./app run dev:prd",
    "deploy": "pnpm --filter ./app run deploy",
    "deploy:prd": "pnpm --filter ./app run deploy:prd",
    "gen:ogimage": "pnpm --filter ./app run gen:ogimage",
    "gen:types": "pnpm --filter ./app run gen:types",
    "test": "pnpm --filter ./app run test",
    "format": "pnpm --filter ./app run format",
    "check:astro": "pnpm --filter ./app run check:astro",
    "check:format": "pnpm --filter ./app run check:format",
    "check:type": "pnpm --filter ./app run check:type",
    "lint:style": "pnpm --filter ./app run lint:style",
    "lint:script": "pnpm --filter ./app run lint:script",
    "lint:markup": "pnpm --filter ./app run lint:markup",
    "e2e": "pnpm run build && pnpm --filter ./app run e2e",
    "storybook": "pnpm --filter ./app run storybook"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.23.0",
    "@eslint/js": "9.39.5",
    "@kubosho/configs": "6.5.38",
    "@markuplint/astro-parser": "4.18.3",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "24.13.3",
    "@typescript-eslint/parser": "8.69.0",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-storybook": "10.6.0",
    "markuplint": "4.18.3",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "semantic-release": "25.0.9",
    "stylelint": "17.15.0",
    "stylelint-config-recommended": "18.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  }
}
