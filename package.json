    "gen:types": "npm run --workspace=app gen:types --",
    "test": "npm run --workspace=app test --",
    "format": "npm run --workspace=app format --",
    "check:astro": "npm run --workspace=app check:astro --",
    "check:format": "npm run --workspace=app check:format --",
    "check:type": "npm run --workspace=app check:type --",
    "lint:style": "npm run --workspace=app lint:style --",
    "lint:script": "npm run --workspace=app lint:script --",
    "lint:markup": "npm run --workspace=app lint:markup --",
