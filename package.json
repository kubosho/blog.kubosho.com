    "eslint-plugin-storybook": "10.5.10",
    "markuplint": "4.18.3",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "semantic-release": "25.0.9",
    "stylelint": "17.14.1",
